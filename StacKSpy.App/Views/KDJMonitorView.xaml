<UserControl x:Class="StacKSpy.App.Views.KDJMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
        <DataGrid x:Name="DgKDJ" ItemsSource="{Binding DataContext.KDJIndicators, RelativeSource={RelativeSource AncestorType=Window}}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="股票代码" Binding="{Binding Code}" Width="100" />
                <DataGridTextColumn Header="股票名称" Binding="{Binding Name}" Width="120" />
                <DataGridTextColumn Header="日线J值" Binding="{Binding DailyJ, StringFormat=F1}" Width="80" />
                <DataGridTextColumn Header="周线J值" Binding="{Binding WeeklyJ, StringFormat=F1}" Width="80" />
                <DataGridTextColumn Header="月线J值" Binding="{Binding MonthlyJ, StringFormat=F1}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
