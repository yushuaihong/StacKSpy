<UserControl x:Class="StacKSpy.App.Views.AlertPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StacKSpy.App.Converters">
    <UserControl.Resources>
        <converters:JValueToColorConverter x:Key="JValueToColor" />
    </UserControl.Resources>
    <Grid Margin="5" Background="{StaticResource DarkBackground}">
        <ListBox x:Name="LbAlerts" ItemsSource="{Binding DataContext.Alerts, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="0"
                 Background="{StaticResource DarkBackground}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,4" Margin="0,2" CornerRadius="3"
                            Background="{Binding JValue, Converter={StaticResource JValueToColor}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Code}" FontWeight="Bold" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Name}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Period}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding JValue, StringFormat='J值: {0:F1}'}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
